@startuml
node "Клиентское устройство" {
    [Браузер]
}

node "Облачная инфраструктура (Docker)" {
    node "Веб-сервер" {
        [Nginx]
    }
    
    node "Сервер приложений" {
        [FastAPI / Uvicorn]
        [Сервис импорта (Worker)]
        [Сервис KPI]
        [Сервис отчётов]
    }
    
    database "PostgreSQL" as DB
    database "Redis" as CACHE
    storage "MinIO / S3" as STORAGE
}

cloud "Внешние сервисы" {
    [SMTP Сервер]
    [Источник данных 1С/CSV]
}

[Браузер] --> [Nginx] : HTTPS
[Nginx] --> [FastAPI / Uvicorn] : HTTP (Reverse Proxy)
[FastAPI / Uvicorn] --> DB : SQL (5432)
[FastAPI / Uvicorn] --> CACHE : Redis protocol (6379)
[Сервис отчётов] --> STORAGE : S3 API (9000)
[Сервис отчётов] --> [SMTP Сервер] : SMTP (587)
[Сервис импорта (Worker)] --> [Источник данных 1С/CSV] : HTTPS / FTP
@enduml
